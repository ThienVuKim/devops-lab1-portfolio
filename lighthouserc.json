
{
  "ci": {
    "collect": {
      "startServerCommand": "npx http-server . -p 8080 -s",
      "startServerReadyPattern": "Available on:",
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/about.html",
        "http://localhost:8080/contact.html"
      ],
      "numberOfRuns": 1
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
